# Database � SQLite (default, no Docker/Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./data/marketshield.db
DATABASE_URL_SYNC=sqlite:///./data/marketshield.db

# PostgreSQL (only if using Docker or local Postgres)
# DATABASE_URL=postgresql+asyncpg://marketshield:marketshield@localhost:5432/marketshield
# DATABASE_URL_SYNC=postgresql://marketshield:marketshield@localhost:5432/marketshield

# App
APP_NAME=MarketShield AI
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML
ML_MODEL_PATH=./data/models
SEED_DEFAULT_DAYS=30

# Frontend (for docker)
VITE_API_URL=http://localhost:8000
# ===== REAL-DATA PROVIDER CONFIGURATION (NEW) =====

# Finnhub API Key (Get it from https://finnhub.io)
# Free tier available with ~60 req/min rate limit
FINNHUB_API_KEY=d8a29h9r01qhv1uvtrq0d8a29h9r01qhv1uvtrqg

# SEC EDGAR User Agent (no API key required, but user agent recommended)
# Format: AppName/Version contact@example.com
SEC_USER_AGENT=MarketShieldAI/1.0 demo@example.com

# Polygon.io API Key (Optional, for real-time streaming)
# Get it from https://polygon.io
POLYGON_API_KEY=59MmxQFpQkV7e8NcuSlnA4ol1qpp0X5y

# Alpha Vantage API Key (Optional, for fallback historical data)
# Get it from https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=27BZ7O20NREP93NV

# GDELT Integration (Optional, for broader news/event analytics)
GDELT_ENABLED=false

# ===== Watchlist Configuration =====
# Comma-separated list of symbols to monitor
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN

# ===== Ingestion Feature Flags =====
MARKET_SYNC_ENABLED=true
NEWS_SYNC_ENABLED=true
FILINGS_SYNC_ENABLED=true

# ===== Ingestion Frequency (in minutes) =====
MARKET_SYNC_INTERVAL=30
NEWS_SYNC_INTERVAL=60
FILINGS_SYNC_INTERVAL=1440

# ===== API Response Cache TTL (in seconds) =====
PROVIDER_CACHE_TTL=300